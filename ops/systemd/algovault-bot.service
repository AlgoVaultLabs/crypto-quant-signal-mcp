[Unit]
Description=AlgoVault Telegram Bot (public)
Documentation=https://github.com/AlgoVaultLabs/algovault-bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=algovault-bot
Group=algovault-bot
WorkingDirectory=/opt/algovault-bot
EnvironmentFile=/etc/algovault-bot/env
ExecStart=/opt/algovault-bot/.venv/bin/python -m algovault_bot
Restart=on-failure
RestartSec=5

# Security hardening (allow only the bot dirs to be writable)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/log/algovault-bot /var/lib/algovault-bot

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=algovault-bot

[Install]
WantedBy=multi-user.target
